const { Client } = require('pg');

const client = new Client({
  user: 'test_station',
  host: 'localhost',
  database: 'testdb',
  password: '',
  port: 5432,
});

client.connect()
  .then(() => console.log('Connected to PostgreSQL!'))
  .catch(err => console.error('Connection error', err.stack))
  .finally(() => client.end());